{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/security/check-repo.mjs && next dev",
    "build": "node scripts/security/check-repo.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "security:check": "node scripts/security/check-repo.mjs",
    "security:scan": "node scripts/security/scan-staged.mjs --all",
    "audit:precommit": "pnpm audit || (echo \"Commit blocked: dependency vulnerabilities found. Fix them (pnpm update / check advisories) before committing.\" && exit 1)",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.30",
    "lucide-react": "^0.548.0",
    "mermaid": "^11.14.0",
    "next": "16.4.1",
    "nodemailer": "^10.0.13",
    "posthog-js": "^1.407.1",
    "posthog-node": "^5.46.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "core-js",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify@>=3.4.13 <=3.4.15": ">=3.4.16",
      "katex": ">=0.18.2",
      "postcss-selector-parser": ">=7.1.6",
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
